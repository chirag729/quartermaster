#include <tunables/global>

profile flutter @{HOME}/.local/share/sdk/flutter/bin/{flutter,dart} flags=(enforce) {
  #include <abstractions/base>
  #include <abstractions/nameservice>
  #include <abstractions/ssl_certs>
  #include <abstractions/user-tmp>
  #include <abstractions/shell-environment>
  #include <abstractions/git-client>
  #include <abstractions/jdk-toolchain>
  #include <abstractions/flutter-sdk>
  #include <abstractions/android-sdk>

  # ── System binaries ────────────────────────────────────────────────
  /bin/* rixm,
  /usr/bin/{[^s]*,?[^n]*,??[^a]*,???[^p]*} rixm,
  /usr/local/bin/** rixm,
  /usr/lib/ r,
  /usr/lib/** rixm,
  /usr/lib64/ r,
  /usr/lib64/** rixm,
  /usr/libexec/** rixm,
  /usr/share/** r,

  # ── Flutter SDK (installation dir — also covered by flutter-sdk abstraction) ─
  owner @{HOME}/.local/share/sdk/flutter/** rwkix,

  # ── Project workspace ──────────────────────────────────────────────
  owner @{HOME}/Development/ r,
  owner @{HOME}/Development/Projects/ r,
  owner @{HOME}/Development/Projects/** rwkl,

  # ── Android SDK ────────────────────────────────────────────────────
  owner @{HOME}/.local/share/sdk/android/** rwkix,

  # ── Java ───────────────────────────────────────────────────────────
  /usr/lib/jvm/** rix,
  /etc/java*/** r,

  # ── Chrome/Chromium (web dev) ──────────────────────────────────────
  /opt/google/chrome/** rix,

  # ── GTK/Linux desktop dependencies ────────────────────────────────
  /usr/include/** r,

  # ── Network ────────────────────────────────────────────────────────
  network inet stream,
  network inet6 stream,
  network inet dgram,
  network inet6 dgram,

  # ── USB debugging ──────────────────────────────────────────────────
  /dev/bus/usb/** rw,
  /sys/bus/usb/** r,
  /sys/devices/** r,

  # ── Proc filesystem ───────────────────────────────────────────────
  @{PROC}/@{pid}/** r,
  @{PROC}/sys/kernel/random/uuid r,

  # ── X11/Wayland ────────────────────────────────────────────────────
  owner @{HOME}/.Xauthority r,
  /tmp/.X11-unix/* rw,
  owner /run/user/*/wayland-* rw,

  # ── Temp files ─────────────────────────────────────────────────────
  owner /tmp/flutter_tools.* rwk,
  owner /tmp/dart* rwk,
  owner /tmp/pub_* rwk,

  # ── Deny sensitive areas ──────────────────────────────────────────
  deny @{HOME}/.ssh/id_* r,
  deny @{HOME}/.gnupg/** rwx,
  deny /etc/shadow r,
}
