#include <tunables/global>

profile claude-code @{HOME}/.nvm/versions/node/*/bin/claude flags=(enforce) {
  #include <abstractions/base>
  #include <abstractions/nameservice>
  #include <abstractions/ssl_certs>
  #include <abstractions/user-tmp>
  #include <abstractions/shell-environment>
  #include <abstractions/claude-code>
  #include <abstractions/git-client>

  # ── System binaries ───────────────────────────────────────────────
  /bin/* rixm,
  /usr/bin/{[^s]*,?[^n]*,??[^a]*,???[^p]*} rixm,
  /usr/local/bin/** rixm,
  /usr/lib/ r,
  /usr/lib/** rixm,
  /usr/lib64/ r,
  /usr/lib64/** rixm,
  /usr/libexec/** rixm,
  /usr/share/** r,

  # ── Git core ───────────────────────────────────────────────────────
  /usr/lib/git-core/** rix,

  # ── Project workspace ──────────────────────────────────────────────
  owner @{HOME}/Development/ r,
  owner @{HOME}/Development/Projects/ r,
  owner @{HOME}/Development/Projects/** rwkl,

  # ── Network (API calls) ───────────────────────────────────────────
  network inet stream,
  network inet6 stream,

  # ── Proc filesystem ───────────────────────────────────────────────
  @{PROC}/@{pid}/** r,

  # ── Deny sensitive areas ──────────────────────────────────────────
  deny @{HOME}/.ssh/id_* r,
  deny @{HOME}/.gnupg/** rwx,
  deny /etc/shadow r,
}
