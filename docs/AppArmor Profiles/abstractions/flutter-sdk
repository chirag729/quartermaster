# vim:syntax=apparmor

# Flutter SDK: SDK installation, Flutter config, Dart tools, pub cache

  # ── SDK installation (Quartermaster default: ~/.local/share/sdk) ─
  owner @{HOME}/.local/share/sdk/ r,
  owner @{HOME}/.local/share/sdk/flutter/ r,
  owner @{HOME}/.local/share/sdk/flutter/** rixm,

  # ── Flutter config ─────────────────────────────────────────────
  owner @{HOME}/.config/flutter/ rwk,
  owner @{HOME}/.config/flutter/** rwklix,

  # ── Dart tools ─────────────────────────────────────────────────
  owner @{HOME}/.dart-tool/ rwk,
  owner @{HOME}/.dart-tool/** rwklix,

  # ── Pub cache ──────────────────────────────────────────────────
  owner @{HOME}/.pub-cache/ rw,
  owner @{HOME}/.pub-cache/** rwk,
